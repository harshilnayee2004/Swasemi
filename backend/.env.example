DATABASE_URL=postgresql+psycopg2://swasemi:swasemi_dev@localhost:5433/fleet
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

