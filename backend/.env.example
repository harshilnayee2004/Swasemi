DATABASE_URL=postgresql+psycopg2://swasemi:swasemi_dev@localhost:5433/fleet
# Development may use the fallback JWT secret; staging and production must set JWT_SECRET.
ENVIRONMENT=development
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

REDIS_URL=redis://localhost:6379/0
REDIS_CHANNEL=fleet:telemetry

MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_TOPIC=swasemi/fleet/+/readings
MQTT_PUBLISH_TOPIC_TEMPLATE=swasemi/fleet/{device_id}/readings
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=

SIMULATOR_API_URL=http://127.0.0.1:8000
SIMULATOR_EMAIL=
SIMULATOR_PASSWORD=
# Number of route positions used to spread discovered vehicles around the loop.
SIMULATOR_POSITION_SPREAD=3
SIMULATOR_INTERVAL_SECONDS=2
SIMULATOR_MAX_CYCLES=0
SIMULATOR_STEP_METERS=30

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
FRONTEND_PUBLIC_URL=http://localhost:5173
INVITE_EXPIRE_HOURS=72

ROUTE_DEVIATION_METERS=200
ROUTE_ALERT_COOLDOWN_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_FROM_EMAIL=
# Real inbox used when org users are @example.com (demo accounts).
ALERT_TO_EMAIL=
# Demo domains (@example.com, @example.org, @example.net, localhost, invalid) are intentionally not emailed.
EXPOSE_DEMO_PASSWORD_HINTS=false
